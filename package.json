{
  "name": "o4o",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api \"npm run dev -w @o4o/web\" \"tsx watch --env-file=.env apps/api/src/main.ts\"",
    "build": "npm run build --workspaces --if-present",
    "test": "tsx --test tests/domain.test.ts tests/detection.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env database/seed.ts",
    "db:local": "node --import tsx scripts/local-db.mts",
    "worker": "tsx --env-file=.env apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  }
}
